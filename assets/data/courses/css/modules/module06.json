{
  "courseId": "css",
  "moduleId": "mod06",
  "title": "Flexbox Layouts",
  "description": "Master CSS Flexbox to create flexible and responsive one-dimensional layouts for modern web designs.",
  "level": "Intermediate",
  "lessons": [
    {
      "lessonId": "mod06-lsn01",
      "title": "Introduction to Flexbox",
      "type": "theory",
      "content": "Flexbox is a CSS layout model that provides an efficient way to align and distribute space among items in a container."
    },
    {
      "lessonId": "mod06-lsn02",
      "title": "Creating a Flex Container",
      "type": "code",
      "content": "container {\n  display: flex;\n}"
    },
    {
      "lessonId": "mod06-lsn03",
      "title": "Flex Direction: row, row-reverse, column, column-reverse",
      "type": "code",
      "content": "container {\n  flex-direction: row;\n}"
    },
    {
      "lessonId": "mod06-lsn04",
      "title": "Justify Content: center, space-between, space-around",
      "type": "code",
      "content": "container {\n  justify-content: space-between;\n}"
    },
    {
      "lessonId": "mod06-lsn05",
      "title": "Align Items and Align Content",
      "type": "code",
      "content": "container {\n  align-items: center;\n  align-content: space-around;\n}"
    },
    {
      "lessonId": "mod06-lsn06",
      "title": "Flex Wrap and Flex Flow",
      "type": "code",
      "content": "container {\n  flex-wrap: wrap;\n  flex-flow: row wrap;\n}"
    },
    {
      "lessonId": "mod06-lsn07",
      "title": "Flex Grow, Shrink, and Basis",
      "type": "code",
      "content": "item {\n  flex-grow: 1;\n  flex-shrink: 1;\n  flex-basis: 100px;\n}"
    },
    {
      "lessonId": "mod06-lsn08",
      "title": "Order Property",
      "type": "code",
      "content": "item {\n  order: 2;\n}"
    },
    {
      "lessonId": "mod06-lsn09",
      "title": "Align Self",
      "type": "code",
      "content": "item {\n  align-self: flex-end;\n}"
    },
    {
      "lessonId": "mod06-lsn10",
      "title": "Mini Project: Responsive Card Layout Using Flexbox",
      "type": "code",
      "content": "/* Build a card layout with flexbox that adjusts to different screen sizes and spacing */"
    }
  ]
}
